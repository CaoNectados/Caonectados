Options -Indexes -MultiViews
DirectoryIndex index.php
DirectorySlash Off
RewriteEngine On

RewriteRule (^|/)\. - [F,L]
RewriteRule ^assets/uploads/comprovantes(?:/|$) - [F,L,NC]
RewriteRule \.(?:sql|log|ini|env|bak|lock|md|json|ya?ml|sh|bat|ps1)(?:/|$) - [F,L,NC]
RewriteRule ^assets/uploads/.*\.(?:php[0-9]?|phtml|phar)(?:/|$) - [F,L,NC]

# Se a URL apontar para um arquivo existente (como imagens/CSS), não faz nada
RewriteCond %{REQUEST_FILENAME} !-f
# Se a URL apontar para um diretório existente, não faz nada
RewriteCond %{REQUEST_FILENAME} !-d

# Joga todas as outras requisições para o index.php processar as rotas
RewriteRule ^(.*)$ index.php [QSA,L]
